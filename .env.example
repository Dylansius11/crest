# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=46630
# Injected EIP-6963 / EIP-1193 wallets do not need a WalletConnect project ID.

# Server only
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Next.js same-origin proxy to the local API; override for a deployed API origin.
CREST_API_URL=http://127.0.0.1:8787
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_PROJECT_REF=
# Runtime RPC. Required for account registration/policy staging and monitor/Guardian.
# Where the public hostname is hijacked locally, use a cache-free SNI-preserving relay (CREST_PROXY_CACHE=off,
# see docs/technical/INSTALLATION.md); never reuse the caching fork proxy (127.0.0.1:8599) for runtime reads.
# Active route: 46630 SANDBOX. It signs testnet transactions but is not reviewed evidence.
ROBINHOOD_CHAIN_RPC_URL=
# Web only: upstream for the same-origin /rpc rewrite; defaults to the active manifest RPC.
CREST_RPC_UPSTREAM=
ROBINHOOD_API_BASE_URL=https://api.robinhood.com/rhj
# Monitor only: an already deployed, registered Crest Account with a canonically activated policy.
CREST_ACCOUNT_ADDRESS=
# Optional poll cadence; --once ignores it. Read-only monitor has no signer key.
MONITOR_INTERVAL_MS=60000

# Guardian process only
GUARDIAN_EXPECTED_CHAIN_ID=46630
GUARDIAN_PRIVATE_KEY=
GUARDIAN_EXPECTED_ADDRESS=
GUARDIAN_ALLOWED_ACCOUNT=

# Active SANDBOX route
DEPLOYMENT_MANIFEST_PATH=./config/deployment-manifest.46630.json

# Optional server-only Groq policy drafting. The API defaults to disabled and the manual policy form always works.
# Set POLICY_LLM_PROVIDER=groq and provide a server secret; never use NEXT_PUBLIC_ for this key.
POLICY_LLM_PROVIDER=disabled
POLICY_LLM_API_KEY=

LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# Fork-proof tooling only (see docs/technical/INSTALLATION.md section 10)
CREST_UPSTREAM_RPC=http://127.0.0.1:8599
CREST_UPSTREAM_IP=
