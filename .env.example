# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server only
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_PROJECT_REF=
# Runtime RPC. Required by the API, monitor, and Guardian; they fail closed when it is unset.
# Never point this at the local fork proxy (127.0.0.1:8599) - that proxy is dev-only tooling.
ROBINHOOD_CHAIN_RPC_URL=
ROBINHOOD_API_BASE_URL=https://api.robinhood.com/rhj
# Monitor only: an already deployed, registered Crest Account with a canonically activated policy.
CREST_ACCOUNT_ADDRESS=
# Optional poll cadence; --once ignores it. Read-only monitor has no signer key.
MONITOR_INTERVAL_MS=60000

# Guardian process only
GUARDIAN_EXPECTED_CHAIN_ID=4663
GUARDIAN_PRIVATE_KEY=
GUARDIAN_EXPECTED_ADDRESS=
GUARDIAN_ALLOWED_ACCOUNT=

# Verified route
DEPLOYMENT_MANIFEST_PATH=./config/deployment-manifest.json

# Optional policy drafting
POLICY_LLM_PROVIDER=disabled
POLICY_LLM_API_KEY=

LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# Fork-proof tooling only (see docs/technical/INSTALLATION.md section 10)
CREST_UPSTREAM_RPC=http://127.0.0.1:8599
CREST_UPSTREAM_IP=
