# ~/crest/api.env on the VPS, mode 600. Never committed with values.
# Supabase session pooler (IPv4), TLS verified against deploy/vps/supabase-root-2021-ca.crt.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full
# Optional policy drafting; the key never reaches the browser.
POLICY_LLM_PROVIDER=disabled
POLICY_LLM_API_KEY=
