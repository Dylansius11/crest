{
  "openapi": "3.1.0",
  "components": {
    "schemas": {
      "Address": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      },
      "Hash": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{64}$"
      },
      "MarketId": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{64}$"
      },
      "VaultId": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*):0x[0-9a-fA-F]{40}$"
      },
      "Rate": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$"
          },
          "scale": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "convention": {
            "type": "string",
            "enum": [
              "apr-simple",
              "apy-compounded"
            ]
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "status": {
            "type": "string",
            "enum": [
              "normal",
              "degraded",
              "unknown"
            ]
          }
        },
        "required": [
          "value",
          "scale",
          "convention",
          "source",
          "observedAt",
          "status"
        ],
        "additionalProperties": false
      },
      "AssetIntent": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "KEEP"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "PROTECT_AND_BORROW"
              },
              "marketId": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              }
            },
            "required": [
              "kind",
              "marketId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "EARN_STABLE"
              },
              "vaultId": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*):0x[0-9a-fA-F]{40}$"
              }
            },
            "required": [
              "kind",
              "vaultId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "EARN_ASSET"
              },
              "availability": {
                "type": "string",
                "const": "post_mvp"
              }
            },
            "required": [
              "kind",
              "availability"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "UNSUPPORTED"
              },
              "reasonCodes": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "kind",
              "reasonCodes"
            ],
            "additionalProperties": false
          }
        ]
      },
      "VerifiedRoute": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "chainId": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "marketId": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "collateralToken": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "loanToken": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "vault": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "vaultAsset": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "marketLltvWad": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        },
        "required": [
          "chainId",
          "marketId",
          "collateralToken",
          "loanToken",
          "vault",
          "vaultAsset",
          "marketLltvWad"
        ],
        "additionalProperties": false
      },
      "PolicyV2": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "const": 2
          },
          "route": {
            "type": "object",
            "properties": {
              "chainId": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "marketId": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              },
              "collateralToken": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "loanToken": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "vault": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "vaultAsset": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "marketLltvWad": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              }
            },
            "required": [
              "chainId",
              "marketId",
              "collateralToken",
              "loanToken",
              "vault",
              "vaultAsset",
              "marketLltvWad"
            ],
            "additionalProperties": false
          },
          "maxCollateralAssets": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "debtCeilingAssets": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "maxStrategyAssets": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "reserveFloorAssets": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "strategyFloorAssets": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "maxRepayPerActionAssets": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "lowerLtvWad": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "targetLtvWad": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "upperLtvWad": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "criticalLtvWad": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "minimumNetSpreadBps": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$"
          },
          "guardian": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          }
        },
        "required": [
          "schemaVersion",
          "route",
          "maxCollateralAssets",
          "debtCeilingAssets",
          "maxStrategyAssets",
          "reserveFloorAssets",
          "strategyFloorAssets",
          "maxRepayPerActionAssets",
          "lowerLtvWad",
          "targetLtvWad",
          "upperLtvWad",
          "criticalLtvWad",
          "minimumNetSpreadBps",
          "guardian"
        ],
        "additionalProperties": false
      },
      "GuardianState": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "enum": [
          "NORMAL",
          "HARVESTABLE",
          "UPSIZE_AVAILABLE",
          "PROTECT",
          "EXIT_YIELD",
          "CRITICAL",
          "DEGRADED"
        ]
      },
      "GuardianAction": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "freeze"
              },
              "selector": {
                "type": "string",
                "const": "freezeBorrowing()"
              }
            },
            "required": [
              "kind",
              "selector"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "repay_reserve"
              },
              "selector": {
                "type": "string",
                "const": "repayFromReserve(uint256)"
              },
              "requestedAssets": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            },
            "required": [
              "kind",
              "selector",
              "requestedAssets"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "repay_strategy"
              },
              "selector": {
                "type": "string",
                "const": "repayFromStrategy(uint256)"
              },
              "requestedAssets": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            },
            "required": [
              "kind",
              "selector",
              "requestedAssets"
            ],
            "additionalProperties": false
          }
        ]
      },
      "ProjectedOrRealized": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "projected"
              },
              "annualCarryAssets": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "spreadBps": {
                "type": "string",
                "pattern": "^(0|-?[1-9][0-9]*)$"
              },
              "observedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": [
              "kind",
              "annualCarryAssets",
              "spreadBps",
              "observedAt"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "realized"
              },
              "transactionHash": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              },
              "blockNumber": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "debtBeforeAssets": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "debtAfterAssets": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "debtRepaidAssets": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              }
            },
            "required": [
              "kind",
              "transactionHash",
              "blockNumber",
              "debtBeforeAssets",
              "debtAfterAssets",
              "debtRepaidAssets"
            ],
            "additionalProperties": false
          }
        ]
      },
      "Health": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "no_debt"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "finite"
              },
              "wad": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              }
            },
            "required": [
              "kind",
              "wad"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
